# Variables del docker-compose local.   Uso:  cp .env.example .env
# El .env NO se versiona. Aqui solo hay valores de desarrollo local, ningun secreto real.

# ── Obligatoria para que los agentes respondan ───────────────────────────────
# API key de Google AI Studio (https://aistudio.google.com/app/apikey).
# Sin ella todo levanta, pero el workflow falla al llamar a Gemini.
GOOGLE_API_KEY=

# ── Cognito ──────────────────────────────────────────────────────────────────
# Pool vigente = el que crea prisma-infra (`terraform output`). Los .env viejos de los
# repos apuntan a us-east-1_h1uG5pYAS (lab anterior): no los mezcles con estos.
# Ninguno de los tres es secreto (Vite los hornea en el bundle publico).
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_eliG8OuZ8
COGNITO_CLIENT_ID=4psjds3mdlg09913f32ilj1ph4
# SIN https://
COGNITO_DOMAIN=prisma-login-fvb422.auth.us-east-1.amazoncognito.com

# ── Infra local ──────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=prisma_local
POSTGRES_PORT=5432
# Secreto compartido workflow <-> Lambda. En local puede ser cualquiera.
INTERNAL_TOKEN=local-internal-token

# ── Opcionales ───────────────────────────────────────────────────────────────
# Solo si LocalStack te pide token de cuenta (ver LOCAL.md).
LOCALSTACK_AUTH_TOKEN=
# Supabase: solo para login/registro legacy de ms-users. Dejar vacio.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Monitor en vivo (Kafka + prisma-monitor) ─────────────────────────────────
# Tarifas en USD por millon de tokens, en JSON. Sin tarifa el costo se muestra "sin tarifa" (nunca 0).
# Completalas con las de tu proveedor (no las inventes):
#   MODEL_PRICES='{"gemini-3.1-flash-lite": {"input": X, "cached_input": Y, "output": Z}}'
# `cached_input` es opcional; sin el, los tokens en cache se cobran a tarifa de entrada.
MODEL_PRICES={}
# Minutos sin eventos para considerar "detenido" un flujo.
STALL_MINUTES=30
# Version de la imagen de Kafka (apache/kafka).
KAFKA_TAG=4.2.2
